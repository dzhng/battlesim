{
  "name": "battle-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "build:wasm": "RUSTFLAGS='-C target-feature=+simd128' wasm-pack build ../crates/game-wasm --target web --release --out-dir ../../web/src/wasm && bun run build:renderer-browser",
    "scene": "node scene.mjs",
    "asset": "node asset.mjs",
    "capture": "node capture.mjs",
    "tutorial-shots": "node tutorial-shots.mjs",
    "install-browsers": "playwright install chromium",
    "check-prerequisites": "node check-prerequisites.mjs",
    "verify": "node scene.mjs",
    "visual": "node scene.mjs --visual",
    "build:renderer-browser": "RUSTFLAGS='-C target-feature=+simd128' wasm-pack build ../crates/renderer-browser --target web --release --out-dir ../../web/src/wasm/renderer_browser"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "math": "0.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.13.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "26.4.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "6.0.3",
    "@webgpu/types": "0.1.72",
    "eslint": "9.39.1",
    "jsdom": "25.0.1",
    "oxfmt": "0.35.0",
    "oxlint": "1.72.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.60.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
