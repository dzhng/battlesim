fn coverageValue(material: u32, uv: vec2f) -> f32 {
  let row = (material * 5u);
  let layer = materials[(row + 4u)].y;
  let image = textureSample(surface, tiled, uv, i32(max(layer, 0f)));
  var value = materials[row].w;
  if ((layer >= 0f)) {
    value = (value * image.w);
  }
  return value;
}

