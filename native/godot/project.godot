[application]
config/name="Battle Game Native"
run/main_scene="res://parity_run.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
; Minimised from the start: macOS clamps a window placed off screen back
; onto it, and a minimised window still renders and reads back.
window/size/mode=1

[shader_globals]

cast_light_count={
"type": "float",
"value": 0.0
}
cast_light_wrap={
"type": "float",
"value": 0.0
}
cast_lights={
"type": "sampler2D",
"value": ""
}

[rendering]
renderer/rendering_method="forward_plus"
; The authored tiers are the only level of detail (world/model_batches.gd):
; Godot's own simplified meshes are never drawn.
mesh_lod/lod_change/threshold_pixels=0.0
textures/vram_compression/import_etc2_astc=true
; Three frames in flight: a record's CPU step runs while the GPU still draws
; the ones before it.
rendering_device/vsync/frame_queue_size=3
