[application]
config/name="Battle Game Native"
run/main_scene="res://parity_run.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
; Minimised from the start: macOS clamps a window placed off screen back
; onto it, and a minimised window still renders and reads back.
window/size/mode=1

[rendering]
renderer/rendering_method="forward_plus"
; The authored tiers are the only level of detail (world/model_batches.gd):
; Godot's own simplified meshes are never drawn.
mesh_lod/lod_change/threshold_pixels=0.0
textures/vram_compression/import_etc2_astc=true
