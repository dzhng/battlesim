// The browser's grass build (`packages/battle-renderer/src/frame/grassPass.ts`
// `buildFn`), ported as text to a GLSL compute shader. One workgroup per 4 m
// world tile of the window: cull the tile, walk its candidate clumps in rank
// order, keep those the ground grows, and append each to the near or far
// tier's MultiMesh buffer, counting it in that tier's indirect draw command.
//
// `grass_layer.gd` compiles it after a generated header: the bindings, the
// ground's defines (`terrain_layer.gd` `shader_header`), the grass params'
// field vec4s (`GRASS_<field>`), `TUNING_<path>` for `tuning.grass`,
// `CONSTANT_<name>` for the build's numbers in `grass.constants`, and the
// browser's ground formulas (`terrain/ground.gdshaderinc`) with its uniforms
// rebound to compute bindings. Numbers that are part of a formula (hashes,
// R2's generator, decorrelation offsets) stay here as text, as in the browser.

// The plastic number's reciprocals: R2's generator.
#define R2 vec2(0.7548776662466927, 0.5698402909980532)

vec4 gp(int at) {
	return uintBitsToFloat(grass_params[at]);
}

uvec4 gpu4(int at) {
	return grass_params[at];
}

// The height grid's word `at` (`terrainSample`).
float grass_sample(uint i, uint j) {
	uint size = heights[0];
	uint cols = heights[1];
	uint count = heights[2];
	if (count == 0u) { return 0.0; }
	uint page = heights[3u + (j / size) * cols + i / size];
	if (page == 0u) { return 0.0; }
	uint at = 3u + count + (page - 1u) * size * size + (j % size) * size + i % size;
	return uintBitsToFloat(heights[at]);
}

float triangle_rule_height(float h00, float h10, float h01, float h11, float u, float v) {
	if (u >= v) { return h00 + u * (h10 - h00) + v * (h11 - h10); }
	return h00 + v * (h01 - h00) + u * (h11 - h01);
}

// Ground height at `q`: the simulation's triangle rule over the grid.
float grass_ground(vec2 q) {
	uint nx = gpu4(GRASS_counts).x;
	uint ny = gpu4(GRASS_counts).y;
	float spacing = gp(GRASS_ground).x;
	float fx = clamp(q.x / spacing, 0.0, float(nx - 1u));
	float fy = clamp(q.y / spacing, 0.0, float(ny - 1u));
	uint i = min(uint(fx), nx - 2u);
	uint j = min(uint(fy), ny - 2u);
	return triangle_rule_height(
		grass_sample(i, j), grass_sample(i + 1u, j),
		grass_sample(i, j + 1u), grass_sample(i + 1u, j + 1u),
		fx - float(i), fy - float(j));
}

// Clumps a square metre holds `dist` metres from the eye and `drop` below it.
float grass_density(float dist, float drop) {
	float facing = clamp(drop / dist, TUNING_density_leastFacing, 1.0);
	float footprint = gp(GRASS_eye).w * dist;
	return min(gp(GRASS_density).y, facing / (gp(GRASS_density).x * footprint * footprint));
}

// Whether `p` lies on a prop's footprint, asked of `p`'s cell of the table.
bool grass_under_prop(vec2 p) {
	vec4 grid = uintBitsToFloat(props[0]);
	uvec4 size = props[1];
	vec2 g = (p - grid.xy) / grid.z;
	if (g.x < 0.0 || g.y < 0.0) { return false; }
	uvec2 c = uvec2(g);
	if (c.x >= size.x || c.y >= size.y) { return false; }
	uint cell = c.y * size.x + c.x;
	uvec4 pair = props[2u + cell / 2u];
	uvec2 run = (cell & 1u) == 1u ? pair.zw : pair.xy;
	for (uint i = 0u; i < run.y; i++) {
		vec4 a = uintBitsToFloat(props[run.x + 2u * i]);
		vec4 b = uintBitsToFloat(props[run.x + 2u * i + 1u]);
		vec2 o = p - a.xy;
		if (abs(dot(o, a.zw)) < b.x && abs(dot(o, vec2(-a.w, a.z))) < b.y) { return true; }
	}
	return false;
}

// Three hashes in [0, 1) of two integers: PCG over a stream seeded by both.
vec3 grass_hash(uint a, uint b) {
	uint s = a * 747796405u + b * 2891336453u + 12345u;
	vec3 result = vec3(0.0);
	for (int k = 0; k < 3; k++) {
		result[k] = float(pcg_hash(s) >> 8u) * (1.0 / 16777216.0);
		s = s * 747796405u + 2891336453u;
	}
	return result;
}

// The tile's world-grid cell, and its own offset of the sequence.
ivec2 grass_tile_cell(vec2 lo) {
	return ivec2(floor(lo / gp(GRASS_window).z + 0.5));
}

// Where candidate `j` of the tile at `lo` falls: the sequence's point,
// jittered by a fixed amount; `h` is its hash.
vec2 grass_fell(vec2 lo, ivec2 cell, vec2 offset, uint j, out vec3 h) {
	float T = gp(GRASS_window).z;
	h = grass_hash(uint(cell.x) ^ (j * 2654435761u), uint(cell.y) + j);
	vec2 jitter = (vec2(fract(h.z * 7.13), fract(h.x * 5.31)) - 0.5) * (2.0 * TUNING_placement_jitterM);
	return lo + T * fract(offset + float(j + 1u) * R2) + jitter;
}

// `groundShoulderGrass`: how much of a field's grass a road's shoulder keeps.
float ground_shoulder_grass(vec2 worn) {
	return mix(1.0, road(uint(worn.y), PARAMS_roads_edge).z, worn.x);
}

// A clump in its tier's MultiMesh buffer, as `grass.gdshader` reads its three
// transform rows: (root, height), (yaw, width, kind, 1), (colour, 1). A tier
// counts every clump it finds and draws the first of them up to its capacity:
// its draw command counts those, as the browser's finish pass clamps its args.
void grass_append(uint tier, vec3 root, float height, vec3 colour, uint kind, float yaw, float width) {
	uint slot = atomicAdd(found[tier], 1u);
	if (slot >= (tier == 0u ? gpu4(GRASS_grid).z : gpu4(GRASS_grid).w)) { return; }
	// The browser keeps the colour as sqrt-encoded rgb8; so does this.
	vec3 stored = unpackUnorm4x8(packUnorm4x8(vec4(sqrt(max(colour, vec3(0.0))), 1.0))).xyz;
	float row[12] = float[12](root.x, root.y, root.z, height, yaw, width, float(kind), 1.0, stored.x, stored.y, stored.z, 1.0);
	uint o = slot * 12u;
	if (tier == 0u) {
		atomicAdd(near_command[1], 1u);
		for (uint k = 0u; k < 12u; k++) { near_clumps[o + k] = row[k]; }
	} else {
		atomicAdd(far_command[1], 1u);
		for (uint k = 0u; k < 12u; k++) { far_clumps[o + k] = row[k]; }
	}
}

layout(local_size_x = 64) in;

void main() {
	uvec2 wg = gl_WorkGroupID.xy;
	uint li = gl_LocalInvocationIndex;
	if (wg.x >= gpu4(GRASS_grid).x || wg.y >= gpu4(GRASS_grid).y) { return; }
	float T = gp(GRASS_window).z;
	vec2 lo = gp(GRASS_window).xy + vec2(float(wg.x), float(wg.y)) * T;
	vec2 hi = lo + vec2(T);
	// The tile's box: its ground at the corners and centre, a metre either
	// way, and the tallest clump above.
	float zlo = 1e9;
	float zhi = -1e9;
	for (uint k = 0u; k < 5u; k++) {
		vec2 q = (lo + hi) * 0.5;
		if (k < 4u) { q = vec2((k & 1u) == 1u ? hi.x : lo.x, k >= 2u ? hi.y : lo.y); }
		float z = grass_ground(q);
		zlo = min(zlo, z);
		zhi = max(zhi, z);
	}
	zlo -= 1.0;
	zhi += 1.0 + gp(GRASS_window).w;
	vec2 lo2 = lo - vec2(TUNING_placement_jitterM + gp(GRASS_clear).y);
	vec2 hi2 = hi + vec2(TUNING_placement_jitterM + gp(GRASS_clear).y);
	for (int i = 0; i < 4; i++) {
		vec4 pl = gp(GRASS_planes + i);
		vec3 pv = vec3(pl.x >= 0.0 ? hi2.x : lo2.x, pl.y >= 0.0 ? hi2.y : lo2.y, pl.z >= 0.0 ? zhi : zlo);
		if (dot(pl.xyz, pv) + pl.w < 0.0) { return; }
	}
	vec3 eye = gp(GRASS_eye).xyz;
	vec3 nearest = clamp(eye, vec3(lo2, zlo), vec3(hi2, zhi));
	float d_near = max(distance(eye, nearest), 0.5);
	if (gp(GRASS_eye).w * d_near >= gp(GRASS_density).w) { return; }
	uint n = uint(ceil(T * T * grass_density(d_near, max(eye.z - zlo, 0.0))));
	ivec2 tile = grass_tile_cell(lo);
	vec2 offset = grass_hash(uint(tile.x), uint(tile.y)).xy;
	for (uint j = li; j < n; j += 64u) {
		vec3 h;
		vec2 fell = grass_fell(lo, tile, offset, j, h);
		float fell_z = grass_ground(fell);
		float dist = max(distance(eye, vec3(fell, fell_z)), 0.5);
		float footprint = gp(GRASS_eye).w * dist;
		if (footprint >= gp(GRASS_density).w) { continue; }
		// Clump j stands once the density passes (j + 1/2) per tile.
		float rank = (float(j) + 0.5) / (T * T);
		float rho = grass_density(dist, max(eye.z - fell_z, 0.0));
		if (rank >= rho) { continue; }
		uvec4 cell = ground_cell(fell, footprint);
		GroundPaved paved = ground_paved(fell, cell);
		vec4 site = ground_site(fell, cell, paved);
		float water = ground_water(fell, cell);
		// Bare within the margins, thinner and lower for a metre beyond them.
		float wood = max(site.w, forest_verge_inside(fell, site.w));
		vec2 line = vec2(0.0, -1e9);
		if (wood > -(gp(GRASS_clear).x + CONSTANT_edgeM)) {
			line = ground_line_band(fell, cell, site.w);
			if (line.x > 0.5) { wood = -1e9; }
		}
		float margin = min(-wood, -water) - gp(GRASS_clear).x;
		if (margin < 0.0) { continue; }
		float shore = ground_shore(fell, footprint, water).z;
		if (shore >= 1.0) { continue; }
		vec2 worn = ground_shoulder(fell, footprint, paved);
		if (worn.x > TUNING_stand_bareWear) { continue; }
		float edge = ss(0.0, CONSTANT_edgeM, min(margin, abs(site.z))) * (1.0 - worn.x);
		int plot_index = int(site.x);
		uint grows = min(uint(plot_field(plot_index, PLOTS_detail).y), uint(GROWTH_ROWS - 2));
		if (ground_verge(site, footprint) > 0.5 || line.y > 0.0) { grows = uint(GROWTH_ROWS - 1); }
		vec4 g = gp(GRASS_growth + int(grows));
		vec4 stand = gp(GRASS_patches + int(grows));
		// A drilled crop keeps to its plot's rows.
		vec4 rows = plot_field(plot_index, PLOTS_rows);
		vec2 p = fell;
		if (g.w > 0.0 && rows.z > 0.0) {
			float across = dot(fell, rows.xy) / rows.z;
			float to_row = (floor(across) + 0.5 - across) * rows.z * g.w;
			float room = max(0.0, min(site.y - ground_params[PARAMS_verge].w, margin) - TUNING_placement_headlandM);
			p = fell + rows.xy * clamp(to_row, -room, room);
		}
		// A wheeling stays bare.
		if (ground_wheeling(p, 0.0, plot_index) > 0.5) { continue; }
		vec3 root = vec3(p, grass_ground(p));
		// Sparse patches: the stand thins there and nowhere thickens. (The
		// browser's scars, phase 2, would leave more out here.)
		float sparse = 1.0 - ss(TUNING_stand_sparseCut_0, TUNING_stand_sparseCut_1, value_noise(p * gp(GRASS_patchScales).y + vec2(41.7, 13.1)));
		float keep = rho * g.x * (1.0 - stand.z * sparse) * mix(TUNING_stand_edgeDensity, 1.0, edge) * (1.0 - shore) * ground_shoulder_grass(worn);
		if (rank >= keep) { continue; }
		if (grass_under_prop(p)) { continue; }
		float grow = 1.0 - ss(TUNING_stand_growFrom * keep, keep, rank);
		float fade = 1.0 - ss(gp(GRASS_density).z, gp(GRASS_density).w, footprint);
		// Which of the row's grasses this clump is.
		float shares[MIX_MAX];
		float total = 0.0;
		uint mixed = uint(g.z);
		for (uint i = 0u; i < mixed; i++) {
			vec4 entry = gp(GRASS_mixes + int(grows) * MIX_MAX + int(i));
			float share = entry.y;
			if (entry.z > 0.0) {
				float drift = ss(TUNING_mix_driftCut_0, TUNING_mix_driftCut_1, value_noise(p * gp(GRASS_patchScales).w + vec2(float(i) * 17.3 + 3.1, float(grows) * 7.9)));
				share *= mix(1.0, TUNING_mix_driftGather * drift, entry.z);
			}
			shares[i] = share;
			total += share;
		}
		uint chosen = 0u;
		if (total > 0.0) {
			chosen = mixed - 1u;
			float roll = fract(h.x * 91.37) * total;
			for (uint i = 0u; i + 1u < mixed; i++) {
				if (roll < shares[i]) { chosen = i; break; }
				roll -= shares[i];
			}
		}
		vec4 grass = gp(GRASS_mixes + int(grows) * MIX_MAX + int(chosen));
		uint kind = uint(grass.x);
		vec4 row = gp(GRASS_kinds + int(kind));
		// Patches a few metres across stand taller or lower.
		float tall = value_noise(p * gp(GRASS_patchScales).x);
		float height = row.x * g.y * grow * fade * mix(CONSTANT_heightVariation_0, CONSTANT_heightVariation_1, h.x) * mix(stand.x, stand.y, tall) * mix(TUNING_stand_edgeHeight, 1.0, edge);
		if (height < TUNING_stand_leastHeightM) { continue; }
		vec3 centre = root + vec3(0.0, 0.0, height * 0.5);
		float radius = height * 0.8 + 0.4;
		bool shown = true;
		for (int i = 0; i < 4; i++) {
			vec4 pl = gp(GRASS_planes + i);
			if (dot(pl.xyz, centre) + pl.w < -radius) { shown = false; }
		}
		if (!shown) { continue; }
		uint tier = 1u;
		if (height / footprint > gp(GRASS_tiers).x * mix(TUNING_tierJitter_0, TUNING_tierJitter_1, h.y)) { tier = 0u; }
		float width = max(1.0, gp(GRASS_tiers).y * footprint / max(row.z, 1e-4));
		// Dry patches, and a grass drier than its neighbours.
		float parched = ss(TUNING_stand_parchedCut_0, TUNING_stand_parchedCut_1, value_noise(p * gp(GRASS_patchScales).z + vec2(9.3, 77.1)));
		float dryness = min(1.0, stand.w * parched + grass.w) * fade;
		float tussock = value_noise(p * gp(GRASS_grain).x + vec2(63.9, 27.4));
		float value = 1.0 + gp(GRASS_shading).z * fade * (fract(h.y * 57.31) + tussock - 1.0);
		vec3 colour = value * (1.0 + gp(GRASS_grain).y * dryness) * ground_tint(ground_colour(p, footprint, site, paved, water).xyz, dryness);
		grass_append(tier, root, height, colour, kind, h.z * 6.2831853, width);
	}
}
