# Large binaries live in Git LFS. The repo is configured with
# `git lfs install --local --skip-smudge`, so checkouts (and worktrees) get
# pointer files; pull only what a task needs (see AGENTS.md).
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf.bin filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# Appearance sources and third-party art are LFS whatever their extension;
# runtime bundles (assets/runtime/<hash>/bundle.bin) are covered by *.bin.
# The catalogs stay text.
assets/source/** filter=lfs diff=lfs merge=lfs -text
assets/third-party/** filter=lfs diff=lfs merge=lfs -text
assets/runtime/audio/** filter=lfs diff=lfs merge=lfs -text

# Ledgers are appended to by every lane: keep both sides of concurrent appends.
specs/**/choices.md merge=union
