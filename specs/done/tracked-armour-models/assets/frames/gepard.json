  "convention": {
    "frame": "x forward, y left, z up, metres; the hull box is centred on x = 0, y = 0 and stands on z = 0",
    "hull_box": "the top is max(the real hull or turret roof, the top of the tallest bulky dressing - 0.3 m) (decisions.md C4, after F-B1). Sights, sensors, radars and roof guns that are not a roster mount are dressing, held to unitArt.ts's 0.3 m bulky / 0.15 m thin allowance. The box covers the body, including an armoured turret overhang (FC8)",
    "pivot": "the centre of the turret ring; for a fixed mount, the trunnion or hinge it is drawn on (only pivot + muzzle reaches the simulation)",
    "muzzle": "muzzle_m is measured from the mount's pivot: the simulation fires from pivot + muzzle (crates/sim/src/weapons/muzzle.rs:12-22; decisions.md C5)",
    "eye": "the sight's height over the ground (catalog.rs:181); kept unless a source contradicts it (FA-6)"
  },
  "thresholds": {
    "hull_dimension": "fix when off by more than max(0.10 m, 3 %)",
    "pivot": "fix when off by more than 0.15 m on any axis",
    "muzzle_point": "fix when the world muzzle point (pivot + muzzle) is off by more than 0.15 m on any axis; a value written in another convention is fixed whatever its size (C5)",
    "eye_m": "kept unless a source contradicts it",
    "note": "One set for every lane (decisions.md C10). The lanes' own variants (F-A's max(0.10 m, 3 %) for muzzles, F-C's 0.30 m muzzle reach) are retired."
  },
  "verdicts": {
    "keep": "the frame number agrees with the references within the thresholds",
    "fix": "slice 15 changes it to `new`: a row in fix-rows.json, or the parent's row where the fixture takes the field through extends",
    "unresolved": "kept at today's value: nothing measures it well enough to move it; named",
    "art-only": "not a frame number: the family slice fixes the art",
    "inherits": "the fixture extends another unit and this appearance takes its rows"
  },
