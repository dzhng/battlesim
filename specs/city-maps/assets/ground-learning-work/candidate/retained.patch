+    /// Map values without expanding a uniform source. Learning uses this to
+    /// stamp exactly the nonblank cells of a newly shared truth page.
+    pub fn map_values<U: Copy + Eq + Default>(&self, map: impl Fn(T) -> U) -> Page<U> {
+        match self {
+            Self::Uniform(value) => Page::Uniform(map(*value)),
+            Self::Runs(source) => {
+                let first = map(source[0].value);
+                if source.iter().all(|run| map(run.value) == first) {
+                    return Page::Uniform(first);
+                }
+                let mut runs: Vec<Run<U>> = Vec::new();
+                for run in source {
+                    let value = map(run.value);
+                    if let Some(previous) =
+                        runs.last_mut().filter(|previous| previous.value == value)
+                    {
+                        previous.end = run.end;
+                    } else {
+                        runs.push(Run {
+                            end: run.end,
+                            value,
+                        });
+                    }
+                }
+                if runs.capacity() * std::mem::size_of::<Run<U>>()
+                    >= std::mem::size_of::<[U; CELLS]>()
+                {
+                    Page::Dense(Box::new(std::array::from_fn(|cell| map(self.get(cell)))))
+                } else {
+                    Page::Runs(runs)
+                }
+            }
+            Self::Dense(source) => {
+                let first = map(source[0]);
+                if source.iter().all(|&value| map(value) == first) {
+                    Page::Uniform(first)
+                } else {
+                    let mut page =
+                        Page::Dense(Box::new(std::array::from_fn(|cell| map(source[cell]))));
+                    page.compress();
+                    page
+                }
+            }
+        }
+    }
+
     pub fn compress(&mut self) {
         let Self::Dense(cells) = self else { return };
         let count = 1 + cells.windows(2).filter(|pair| pair[0] != pair[1]).count();
