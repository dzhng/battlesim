//! Full learned-ground resource proof through the production public seams.
use contract::ids::Side;
use contract::observation::{ObservationFrame, VisibilityField};
use contract::scenario::Rules;
use sim::ground::{GroundLayer, KnownGround, Wear};
use sim::math::v2;
use sim::publication::{self, FogPatch, GroundHeader};
#[path = "common/instructions.rs"]
mod instructions;
use std::alloc::{GlobalAlloc, Layout, System};
use std::sync::atomic::{AtomicUsize, Ordering};
use std::time::Instant;

struct Counter;
static CURRENT: AtomicUsize = AtomicUsize::new(0);
static PEAK: AtomicUsize = AtomicUsize::new(0);
fn add(n: usize) {
    let live = CURRENT.fetch_add(n, Ordering::Relaxed) + n;
    PEAK.fetch_max(live, Ordering::Relaxed);
}
unsafe impl GlobalAlloc for Counter {
    unsafe fn alloc(&self, l: Layout) -> *mut u8 {
        if CURRENT.load(Ordering::Relaxed).saturating_add(l.size()) > 4 * 1024 * 1024 * 1024 {
            std::process::exit(70);
        }
        let p = System.alloc(l);
        if !p.is_null() {
            add(l.size());
        }
        p
    }
    unsafe fn alloc_zeroed(&self, l: Layout) -> *mut u8 {
        if CURRENT.load(Ordering::Relaxed).saturating_add(l.size()) > 4 * 1024 * 1024 * 1024 {
            std::process::exit(70);
        }
        let p = System.alloc_zeroed(l);
        if !p.is_null() {
            add(l.size());
        }
        p
    }
    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
        System.dealloc(p, l);
        CURRENT.fetch_sub(l.size(), Ordering::Relaxed);
    }
    unsafe fn realloc(&self, p: *mut u8, l: Layout, n: usize) -> *mut u8 {
        if CURRENT.load(Ordering::Relaxed).saturating_add(n) > 4 * 1024 * 1024 * 1024 {
            std::process::exit(70);
        }
        let q = System.realloc(p, l, n);
        if !q.is_null() {
            if n >= l.size() {
                add(n - l.size());
            } else {
                CURRENT.fetch_sub(l.size() - n, Ordering::Relaxed);
            }
        }
        q
    }
}
#[global_allocator]
static ALLOC: Counter = Counter;
fn stage<T>(name: &str, work: impl FnOnce() -> T) -> T {
    let before = CURRENT.load(Ordering::Relaxed);
    PEAK.store(before, Ordering::Relaxed);
    let instructions_before = instructions::instructions();
    let start = Instant::now();
    let value = work();
    let current = CURRENT.load(Ordering::Relaxed);
    let peak = PEAK.load(Ordering::Relaxed);
    println!(
        "{}",
        serde_json::json!({"stage":name,"ms":start.elapsed().as_secs_f64()*1000.0,"before_bytes":before,"live_bytes":current,"stage_peak_bytes":peak,"instructions":instructions::instructions().zip(instructions_before).map(|(after,before)|after-before)})
    );
    value
}

fn main() {
    let extent: usize = std::env::args().nth(1).unwrap().parse().unwrap();
    assert!([256, 1024, 12000, 15000, 18000].contains(&extent));
    let rules: Rules = serde_json::from_value(sim::fixtures::village()).unwrap();
    assert_eq!(rules.ground.cell_m, 1.0);
    let mut truth = stage("truth_empty", || {
        GroundLayer::new(extent as f64, extent as f64, &rules.ground)
    });
    let mut blue = stage("blue_empty", || KnownGround::new(&truth));
    let mut red = stage("red_empty", || KnownGround::new(&truth));
    let nx = (extent as f64 / rules.sensors.fog_cell_m).ceil() as u32;
    let mut fog = stage("full_visibility", || VisibilityField {
        cell_m: rules.sensors.fog_cell_m,
        nx,
        ny: nx,
        bits: vec![u32::MAX; (nx as usize * nx as usize).div_ceil(32)],
    });
    let valid = nx as usize * nx as usize % 32;
    if valid != 0 {
        *fog.bits.last_mut().unwrap() = (1u32 << valid) - 1;
    }
    println!(
        "{}",
        serde_json::json!({"extent_m":extent,"ground_cell_m":truth.cell_m(),"ground_cells":extent*extent,"fog_cell_m":fog.cell_m,"heap_ceiling_bytes":4u64*1024*1024*1024,"resource_exit":70,"scope":"ground + two learned owners + production pack + two retained credit copies; no Battle/JS/GPU"})
    );
    stage("clear_every_cell", || {
        // Tile/local order models the same final public clear calls while keeping
        // traversal separate from any production import/helper shortcut.
        for ty in (0..extent).step_by(16) {
            for tx in (0..extent).step_by(16) {
                for j in ty..(ty + 16).min(extent) {
                    for i in tx..(tx + 16).min(extent) {
                        truth.clear(v2(i as f64 + 0.5, j as f64 + 0.5));
                    }
                }
            }
        }
    });
    stage("seal_truth", || truth.seal());
    stage("learn_blue", || blue.learn(&truth, &fog));
    stage("learn_red", || red.learn(&truth, &fog));
    stage("unchanged_learning_blue", || blue.learn(&truth, &fog));
    stage("unchanged_learning_red", || red.learn(&truth, &fog));
    assert_eq!(
        blue.cell(extent as f64 - 0.5, extent as f64 - 0.5).cleared,
        255
    );
    assert_eq!(red.cell(0.5, 0.5).cleared, 255);
    let count = stage("count_blue_runs", || blue.change_runs_since(0).count());
    let cells: usize = blue.change_runs_since(0).map(|r| r.len as usize).sum();
    assert_eq!(cells, extent * extent);
    let mut frame = ObservationFrame {
        ground_visibility: fog.clone(),
        ..Default::default()
    };
    let full = GroundHeader {
        epoch: 1,
        side: Side::Blue,
        base: 0,
        revision: blue.revision(),
        full: true,
        count,
    };
    let mut out = Vec::new();
    let snapshot_bytes = stage("pack_blue_snapshot", || {
        publication::pack(
            &frame,
            &full,
            &FogPatch {
                full: true,
                base: 0,
                revision: 1,
                changed: &[],
            },
            blue.change_runs_since(0),
            &mut out,
        )
        .unwrap();
        out.len() * 4
    });
    let credit_a = stage("retain_credit_a", || out.clone());
    let credit_b = stage("retain_credit_b", || out.clone());
    stage("pack_blue_resync", || {
        publication::pack(
            &frame,
            &GroundHeader { epoch: 2, ..full },
            &FogPatch {
                full: true,
                base: 0,
                revision: 2,
                changed: &[],
            },
            blue.change_runs_since(0),
            &mut out,
        )
        .unwrap()
    });
    let payload = count * 4 + frame.ground_visibility.bits.len() * 2;
    assert_eq!(
        &out[out.len() - payload..],
        &credit_a[credit_a.len() - payload..]
    );
    let mut first_wear = rules.ground.clone();
    first_wear.trampled_per_pass = 23.0;
    stage("one_visible_edit", || {
        truth.wear(v2(1.5, 0.5), v2(0.5, 0.5), Wear::Trampled, &first_wear);
        truth.seal();
    });
    stage("learn_one_edit_full_visibility", || {
        blue.learn(&truth, &fog)
    });
    assert_eq!(blue.cell(0.5, 0.5).trampled, 23);
    assert_eq!(red.cell(0.5, 0.5).trampled, 0);
    let old_revision = blue.revision();
    let mut wear = rules.ground;
    wear.trampled_per_pass = 73.0;
    stage("hidden_corner_churn", || {
        truth.wear(
            v2(extent as f64 - 1.5, extent as f64 - 0.5),
            v2(extent as f64 - 0.5, extent as f64 - 0.5),
            Wear::Trampled,
            &wear,
        );
        truth.seal();
    });
    let mut partial = VisibilityField {
        bits: vec![0; fog.bits.len()],
        ..fog.clone()
    };
    stage("hidden_learning", || blue.learn(&truth, &partial));
    assert_eq!(blue.revision(), old_revision);
    assert_eq!(
        blue.cell(extent as f64 - 0.5, extent as f64 - 0.5).trampled,
        0
    );
    let last = nx as usize * nx as usize - 1;
    partial.bits[last / 32] |= 1 << (last % 32);
    stage("reveal_corner", || blue.learn(&truth, &partial));
    assert_eq!(
        blue.cell(extent as f64 - 0.5, extent as f64 - 0.5).trampled,
        73
    );
    assert_eq!(
        red.cell(extent as f64 - 0.5, extent as f64 - 0.5).trampled,
        0
    );
    let delta_count = blue.change_runs_since(old_revision).count();
    assert_eq!(delta_count, 1);
    frame.ground_visibility = partial;
    stage("pack_corner_delta", || {
        publication::pack(
            &frame,
            &GroundHeader {
                epoch: 2,
                side: Side::Blue,
                base: old_revision,
                revision: blue.revision(),
                full: false,
                count: delta_count,
            },
            &FogPatch {
                full: true,
                base: 2,
                revision: 3,
                changed: &[],
            },
            blue.change_runs_since(old_revision),
            &mut out,
        )
        .unwrap()
    });
    assert_eq!(credit_a, credit_b);
    println!(
        "{}",
        serde_json::json!({"snapshot_bytes":snapshot_bytes,"uniform_runs":count,"learned_cells":cells,"truth_payload_estimate":truth.bytes(),"blue_payload_estimate":blue.bytes(),"red_payload_estimate":red.bytes(),"corner_delta_runs":delta_count,"blue_revision":blue.revision(),"red_revision":red.revision()})
    );
}
