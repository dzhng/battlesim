#[path = "../tests/common/mod.rs"]
mod common;
use contract::map::MapDefinition;
use serde_json::{json,Value};
use sim::world::WorldGeometry;

fn capture(name:&str,map:MapDefinition,rules:&contract::scenario::Rules,scenario:Value){
 let world=WorldGeometry::new(&common::physical_map(map,rules),rules);
 let foliage=world.export_foliage();
 let native_foliage=foliage[3..].chunks_exact(4).map(|r|{
  let f=world.foliage_at((r[0] as f64+0.5)*foliage[2] as f64,(r[1] as f64+0.5)*foliage[2] as f64);
  json!([r[0],r[1],f.canopy_m.to_bits(),f.depth_per_m.to_bits(),f.infantry.to_bits(),f.vehicle.to_bits()])
 }).collect::<Vec<_>>();
 println!("{}",json!({"name":name,"native_props":world.props().map(|p|json!([p.id,p.center.x.to_bits(),p.center.y.to_bits(),p.base_z.to_bits(),p.half.x.to_bits(),p.half.y.to_bits(),p.half.z.to_bits(),p.yaw.to_bits(),p.canopy.map(|c|c.height_m.to_bits())])).collect::<Vec<_>>(),"props":world.export_props(),"forests":world.export_forests(),"foliage":foliage,"native_foliage":native_foliage,"scenario":scenario}));
}
fn main(){
 let rules=common::rules();
 for file in ["village.json","movement-lab.json","geometry-lab.json","sensors-lab.json","consequences-lab.json"]{
  let v:Value=serde_json::from_str(&std::fs::read_to_string(sim::fixtures::dir().join(file)).unwrap()).unwrap();
  let source=if file=="village.json"{&v["map"]}else{&v};
  capture(file,serde_json::from_value(source.clone()).unwrap(),&rules,Value::Null);
 }
 for seed in [1,7]{ for late in [false,true]{
  let s=sim::endurance::scenario(&common::village(),seed,late).unwrap();
  capture(&format!("endurance-{seed}-{late}"),s.map.clone(),&s.rules,json!({"units":s.units,"scripts":s.scripts,"events":s.events}));
 }}
 // Exact stimuli from the original live rectangular forest producers. This
 // adapter changes only the historical source codec between the two arms.
 let use_shape=common::village()["map"]["forests"][0].get("shape").is_some();
 for (n,rect) in [[0.,0.,120.,120.],[150.,0.,120.,120.],[40.,0.,200.,120.],[0.,0.,60.,60.],[70.,0.,60.,40.],[70.,0.,60.,80.],[40.,0.,120.,120.],[60.,0.,80.,80.],[300.,0.,60.,45.],[300.,55.,60.,45.],[50.,0.,120.,80.],[0.,0.,19.,12.],[680.,280.,40.,40.],[450.,250.,150.,150.],[108.,194.,65.,40.],[24.,12.,16.,20.]].into_iter().enumerate(){
  for density in ["light","medium","dense"]{
   let [x,y,w,h]=rect;
   let mut f=json!({"rect":rect,"density":density,"canopy_height_m":12,"trunk_radius_m":0.35,"trunk_height_m":10,"trunk_clearance_m":2});
   if use_shape{f.as_object_mut().unwrap().remove("rect");f["shape"]=json!({"kind":"polygon","ring":[[x,y],[x+w,y],[x+w,y+h],[x,y+h]]});}
   let map=serde_json::from_value(json!({"size":[800,500],"height_grid_m":4,"fog_cell_m":8,"slope_cutoff_deg":35,"forests":[f]})).unwrap();
   capture(&format!("producer-{n}-{density}"),map,&rules,Value::Null);
  }
 }
}
