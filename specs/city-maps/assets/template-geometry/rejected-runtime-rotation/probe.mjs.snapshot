import {readFileSync,writeFileSync} from 'node:fs';
import {execFileSync} from 'node:child_process';
import {initSync,materialize_template} from '/Users/david/.codex/worktrees/procedural-map-systems/battlegame/web/src/wasm/game_wasm.js';
const root='/Users/david/.codex/worktrees/procedural-map-systems/battlegame';
initSync({module:readFileSync(root+'/web/src/wasm/game_wasm_bg.wasm')});
const descriptor=root+'/specs/city-maps/assets/template-geometry/asymmetric.json';
const input=readFileSync(descriptor,'utf8');
function diff(a,b,path='') {
 if(typeof a!==typeof b)return {path,a,b};
 if(a===null||typeof a!=='object')return Object.is(a,b)?null:{path,a,b};
 for(const k of Object.keys(a)){const found=diff(a[k],b[k],path+'/'+k);if(found)return found;}
 return null;
}
let mismatches=[];let cases=[];
for(let i=0;i<96;i++) {
 const frame=JSON.stringify({translation:[40,60,0],yaw:(i+0.123456789)*0.137});
 const native=JSON.parse(execFileSync('/Users/david/dev/battlegame/target/wt/procedural-map-systems/release/examples/template_report',[descriptor,frame],{encoding:'utf8'})).materialized;
 const wasm=JSON.parse(materialize_template(input,frame));
 const found=diff(native,wasm);
 cases.push({frame:JSON.parse(frame),native,wasm});
 if(found)mismatches.push({frame:JSON.parse(frame),...found});
}
writeFileSync(root+'/throwaway/template-rotation-parity.json',JSON.stringify({cases,mismatches},null,2));
console.log(JSON.stringify({count:cases.length,mismatches:mismatches.length,first:mismatches.slice(0,5)},null,2));
