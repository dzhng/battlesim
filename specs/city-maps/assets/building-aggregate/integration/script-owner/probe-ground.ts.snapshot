import {readFileSync, writeFileSync} from 'node:fs';
import * as old from './terrain-before-wasm/game_wasm.js';
import * as current from '../../web/src/wasm/game_wasm.js';
import {decodeObservation as decodeOld} from './original-observation';
import {ObservationDecoder} from '../../web/src/battle/sim/observation';
import {GroundView} from '../../web/src/battle/sim/ground';
const oracle = JSON.parse(readFileSync('specs/city-maps/assets/building-aggregate/oracle.json','utf8'));
const originalRules = oracle.arms.find((a:any)=>a.name==='village').scenario.rules;
const original = {...JSON.parse(readFileSync('throwaway/city-spike/original-village.json','utf8')),catalog:originalRules.catalog};
const fixture = JSON.parse(readFileSync('fixtures/village.json','utf8'));
const results:any[]=[];
for(const [label,api,input,wasm] of [
  ['original',old,original,'throwaway/city-spike/terrain-before-wasm/game_wasm_bg.wasm'],
  ['current',current,{...fixture,catalog:original.catalog},'web/src/wasm/game_wasm_bg.wasm'],
] as const) {
  const mem = api.initSync({module:readFileSync(wasm)}).memory;
  const scenario=api.village_scenario(JSON.stringify(input),'ordinary');
  const battle=api.Battle.scripted(scenario,fixture.seed,'scout-suppress-flank');
  const layout=JSON.parse(battle.observation_layout());
  const result:any={label,checkpoints:[]};
  for(let tick=1; tick<=3602; tick++) {
    battle.step();
    if(tick%300!==0 && tick!==3601 && tick!==3602) continue;
    const sides:any={};
    for(const side of ['blue','red']) {
      battle.resync_observation?.();
      const length=battle.publish(side);
      const record=new Float32Array(mem.buffer,battle.publication_ptr(),length).slice();
      if(label==='original') {
        const patch=decodeOld(layout,record).groundPatch;
        sides[side]=[...patch.cells].map((id,k)=>[id,...patch.marks.slice(k*4,k*4+4)]).filter(row=>row.slice(1).some(n=>n>0));
      } else {
        const decoder=new ObservationDecoder(layout);
        const observation=decoder.decode(record)!;
        const view=new GroundView({cellM:layout.ground.cellM,cols:layout.ground.cols,rows:layout.ground.rows});
        view.applyRuns(observation.groundPatch);
        const cells:number[][]=[];
        view.forEachMarked((i,j)=>{const m=view.cell(i,j);cells.push([j*view.cols+i,m.crater,m.scorch,m.tracks,m.trampled]);});
        sides[side]=cells;
      }
      sides[side].sort((a:number[],b:number[])=>a[0]-b[0]);
    }
    const keys=(side:string)=>new Set(sides[side].map((row:number[])=>row[0]));
    const blue=keys('blue'),red=keys('red');
    result.checkpoints.push({tick,digest:battle.digest(),blue:sides.blue.length,red:sides.red.length,onlyBlue:sides.blue.filter((r:number[])=>!red.has(r[0])).length,onlyRed:sides.red.filter((r:number[])=>!blue.has(r[0])).length,blueCraters:sides.blue.filter((r:number[])=>r[1]>0).length,redCraters:sides.red.filter((r:number[])=>r[1]>0).length});
    if(tick===3602) result.cells=sides;
  }
  battle.free();results.push(result);
}
writeFileSync('throwaway/city-spike/village-ground-comparison.json',JSON.stringify(results,null,2)+'\n');
console.log(JSON.stringify(results.map(({cells,...summary})=>summary),null,2));
