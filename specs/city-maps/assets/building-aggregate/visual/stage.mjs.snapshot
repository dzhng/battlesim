import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
import { initSync, materialize_template, template_catalogue_json } from '../../../web/src/wasm/game_wasm.js';
initSync({module:readFileSync('web/src/wasm/game_wasm_bg.wasm')});
const paths=['fixtures/garrison-lab.json','fixtures/catalog.json','fixtures/village.json','apps/battle-lab/src/routes/garrison.tsx','packages/battle-renderer/src/models/propAppearance.ts','packages/battle-renderer/src/frame/fogInputs.ts','crates/sim/src/garrison.rs'];
for(let i=0;i<paths.length;i++) writeFileSync(`throwaway/building-aggregate/visual-staging/original-${i}`,readFileSync(paths[i]));
writeFileSync('throwaway/building-aggregate/visual-staging/paths.json',JSON.stringify(paths));
const d=JSON.parse(readFileSync('specs/city-maps/assets/template-geometry/asymmetric.json'));
const geometry=JSON.parse(materialize_template(JSON.stringify(d),JSON.stringify({translation:[360,250,0],yaw:0})));
const catalogue=JSON.parse(template_catalogue_json(JSON.stringify([d])));
console.log(catalogue);
const map={size:[640,480],fog_cell_m:8,height_grid_m:4,slope_cutoff_deg:35,props:[{id:2,kind:'tooth',center:[600,430],yaw:0,half_extents:[.6,.6,.6]}],buildings:[{owner:0,kind:'building',category:d.category,regional_family:d.regional_family,parts:[{part:'main',prop:0},{part:'wing',prop:1}],geometry}],template_catalog_hash:catalogue.hash};
writeFileSync('fixtures/garrison-lab.json',JSON.stringify(map,null,2)+'\n');
const c=JSON.parse(readFileSync('fixtures/catalog.json'));
for(const p of [c.props,...c.documents.filter(x=>x.props).map(x=>x.props)]){
 p.building.body.hp=1000;p.building.destroyed={into:{prop:'wall',height_m:2}};
 p.wall.body.hp=200;p.wall.body.garrison=true;p.wall.destroyed={into:{prop:'rubble',height_m:2}};p.wall.appearance={drawn_by:'ruin',remains_state:'ruin'};
 p.rubble.appearance={drawn_by:'ruin',remains_state:'ruin'};
}
writeFileSync('fixtures/catalog.json',JSON.stringify(c,null,2)+'\n');
const v=JSON.parse(readFileSync('fixtures/village.json'));v.weapons.tank_he.structural_damage=100;v.weapons.tank_he.blast_radius_m=20;writeFileSync('fixtures/village.json',JSON.stringify(v,null,2)+'\n');
let r=readFileSync('apps/battle-lab/src/routes/garrison.tsx','utf8');
r=r.replace('position: [290, 250]','position: [382, 250]').replace('position: [325, 250]','position: [385, 285]');
r=r.replace('  [],\n  [\n    {\n      tick: TANK_OPENS_FIRE,','  '+JSON.stringify([...Array.from({length:11},(_,i)=>600+i),1200,1201,1202].map(tick=>({tick,burst:{point:[369,251],weapon:'tank_he'}})))+',\n  [\n    {\n      tick: TANK_OPENS_FIRE,');
writeFileSync('apps/battle-lab/src/routes/garrison.tsx',r);
for(const path of paths.slice(0,4)) writeFileSync(`throwaway/building-aggregate/visual-staging/staged-${paths.indexOf(path)}`,readFileSync(path));
