import {mkdir,writeFile} from 'node:fs/promises';
import {chromium} from '../../../web/node_modules/playwright/index.mjs';
import {startServer,WEBGPU_FLAGS,guardMeasures,MEASURE_ENTRIES_MAX} from '../../../web/scene.mjs';
import {lab,obs,advance,presented} from '../../../web/scenes/_lab.mjs';
import {decode,writeCrop} from '../../../web/scenes/_png.mjs';
const arm=process.argv[2]??'candidate';
const dir=`throwaway/building-aggregate/visual-${arm}`;await mkdir(dir,{recursive:true});
const server=await startServer();const browser=await chromium.launch({channel:'chromium',args:WEBGPU_FLAGS});
const errors=[];const records=[];
try{
 const page=await browser.newPage({viewport:{width:1920,height:1080},deviceScaleFactor:1});await page.addInitScript(guardMeasures,MEASURE_ENTRIES_MAX);
 page.on('pageerror',e=>errors.push(e.message));page.on('console',m=>{if(m.type()==='error')errors.push(m.text())});
 await page.goto(server.url+'/lab/garrison');await page.waitForFunction(()=>window.__lab?.ready||window.__lab?.error,undefined,{timeout:30000});
 await page.waitForFunction(()=>window.__lab.route?.tick()>3);await lab(page,()=>window.__lab.route.pause());
 await lab(page,()=>window.__lab.setCamera({...window.__lab.camera(),target:[344,249,0],distance:75,pitch:.95,yaw:-.75}));
 await lab(page,()=>window.__lab.route.command({kind:'garrison',units:[0],building:0}));await lab(page,()=>window.__lab.route.select([0]));
 for(const [name,tick]of[['standing',300],['first-remains',640],['holdable-remains',1150],['second-remains',1240]]){
  if(name==='holdable-remains'){await lab(page,()=>window.__lab.route.command({kind:'garrison',units:[2],building:3}));await lab(page,()=>window.__lab.route.select([2]));}
  await advance(page,tick-(await lab(page,()=>window.__lab.route.tick())));await presented(page);
  await lab(page,()=>window.__lab.frame());await page.waitForTimeout(60);await lab(page,()=>window.__lab.frame());
  const o=await obs(page);const models=await lab(page,()=>window.__lab.route.structures());const camera=await lab(page,()=>window.__lab.camera());
  const png=await page.screenshot();await writeFile(`${dir}/${name}.png`,png);
  const p=await lab(page,()=>window.__lab.projectToCss(362,250,2));await writeCrop(decode(png),`${dir}/${name}-crop.png`,p[0],p[1],385,270,2);
  records.push({name,tick:o.tick,digest:await lab(page,()=>window.__lab.route.digest()),observation:o,camera,known:o.knownProps,own:o.own.map(u=>({id:u.id,garrison:u.garrison,members:u.members})),models});
 }
 await writeFile(`${dir}/metadata.json`,JSON.stringify({arm,browser:browser.version(),viewport:[1920,1080],dpr:1,records,errors},null,2));
 if(errors.length)throw new Error(errors.join('\n'));
 console.log(JSON.stringify(records.map(r=>({name:r.name,tick:r.tick,known:r.known.map(p=>({id:p.id,kind:p.kind,source:p.authoredProp})),garrisons:r.own.map(u=>({id:u.id,garrison:u.garrison})),models:r.models})),null,2));
}finally{await browser.close();await server.close()}
