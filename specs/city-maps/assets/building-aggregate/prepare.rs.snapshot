use contract::map::{MapDefinition,AuthoredPropDefinition,BuildingDefinition,BuildingPartReference};
use contract::templates::{BuildingTemplateDescriptor,BuildingCategory,PlacementFrame,TemplateGeometryCatalog};
use serde_json::{json,Value};
use std::collections::BTreeMap;
fn descriptor(half:[f64;3])->BuildingTemplateDescriptor {
 BuildingTemplateDescriptor::solid_box(format!("api-box-{}-{}-{}",half[0],half[1],half[2]),BuildingCategory::Farmstead,"api_fixture".into(),half)
}
fn main() {
 let rules=serde_json::from_value(sim::fixtures::village()).unwrap();
 let mut maps=BTreeMap::new();let mut templates=BTreeMap::new();let mut receipt=Vec::new();
 for path in std::fs::read_dir(sim::fixtures::dir()).unwrap().map(|e|e.unwrap().path()).filter(|p|p.extension().is_some_and(|x|x=="json")) {
  let raw=std::fs::read_to_string(&path).unwrap();let v:Value=serde_json::from_str(&raw).unwrap();
  let map_value=if v.get("size").is_some(){&v}else{&v["map"]};
  if !map_value.is_object(){continue}
  let mut map:MapDefinition=serde_json::from_value(map_value.clone()).unwrap();
  let old=sim::world::WorldGeometry::new(&map,&rules);let mut ordinary=Vec::new();let mut buildings=Vec::new();
  for (id,p) in map.props.iter().enumerate() {
   let id=id as u32;
   if old.prop(id).unwrap().body.garrison {
    let d=descriptor(p.half_extents);templates.insert(d.id.clone(),d.clone());
    buildings.push(BuildingDefinition::materialize(&d,PlacementFrame{translation:[p.center[0],p.center[1],old.prop(id).unwrap().base_z],yaw:p.yaw},p.kind.clone(),id,vec![BuildingPartReference{part:"body".into(),prop:id}]).unwrap());
    receipt.push(json!({"fixture":path.file_name().unwrap().to_str().unwrap(),"prop":id,"template":d.id,"center":p.center,"yaw":p.yaw,"half_extents":p.half_extents,"base_z":old.prop(id).unwrap().base_z}));
   }else{ordinary.push(AuthoredPropDefinition{id:Some(id),geometry:p.geometry.clone()});}
  }
  if buildings.is_empty(){continue}
  map.props=ordinary;map.buildings=buildings;maps.insert(path.file_name().unwrap().to_str().unwrap().to_string(),map);
 }
 let d=descriptor([12.0,10.0,4.0]);templates.insert(d.id.clone(),d);
 let catalogue=TemplateGeometryCatalog::new(templates.into_values().collect()).unwrap();
 for map in maps.values_mut(){map.template_catalog_hash=Some(catalogue.hash().into());map.authored_props().unwrap();}
 std::fs::write("throwaway/building-aggregate/migrated-maps.json",serde_json::to_string_pretty(&maps).unwrap()).unwrap();
 std::fs::write("fixtures/building-templates.json",catalogue.canonical_json().unwrap()+"\n").unwrap();
 std::fs::write("specs/city-maps/assets/building-aggregate/producer-cutover.json",serde_json::to_string_pretty(&json!({"source_commit":"94e969b","classification":"provisional API eligibility; not accepted regional/category art source","shipped":receipt,"endurance":{"template":"api-box-12-10-4","original_ids":"0..12"},"catalogue_hash":catalogue.hash()})).unwrap()+"\n").unwrap();
}
