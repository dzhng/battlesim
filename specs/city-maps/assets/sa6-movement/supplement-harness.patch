+fn diagnostic(s: &Scenario, root: &Path) {
+    create_dir_all(root.join(s.name)).unwrap();
+    let hz = scenarios::tick_hz(s);
+    let trails = Trails::new();
+    let outcomes = scenarios::run(s, |b| {
+        if b.tick() % TICKS_PER_FRAME != 0 { return; }
+        let seconds = b.tick() as f64 / hz as f64;
+        let unit = scenarios::units(b).next().unwrap();
+        let centre = unit.position.xy();
+        let bridge = v2(1500.0, 200.0);
+        let near_bridge = s.name == "sa6-distant-bridge" && (centre - bridge).length() < 90.0;
+        let moment = [0.0, 0.4, 2.0, 10.0, 50.0, 100.0, 200.0, 300.0, 450.0, 600.0].iter().any(|t| (seconds - t).abs() < 0.01);
+        if !moment && !near_bridge { return; }
+        for (name, view) in [
+            ("overview", View { scale: 800.0/6000.0, min_x: -3300.0, max_y: 6000.0 }),
+            ("tracked", View { scale: 12.8, min_x: centre.x - 50.0, max_y: centre.y + 31.25 }),
+            ("bridge", View { scale: 16.0, min_x: 1460.0, max_y: 225.0 }),
+        ] {
+            if name == "bridge" && s.name != "sa6-distant-bridge" { continue; }
+            let dir = root.join(s.name).join(name); create_dir_all(&dir).unwrap();
+            let bg = background(b, view, 1280, 834);
+            let cv = frame(s, hz, b, view, &bg, &trails);
+            cv.write(&dir.join(format!("t{:04}.png", b.tick()/TICKS_PER_FRAME)));
+        }
+        println!("{} {:.1}s {:?}", s.name, seconds, centre);
+    });
+    for o in outcomes { println!("{} diagnostic check {}", s.name, o.passed); }
+}
+
 fn main() {
+    if let Ok(root) = std::env::var("SA6_DIAGNOSTIC_ROOT") {
+        for s in scenarios::scenarios().iter().filter(|s| ["sa6-unbridged-river", "sa6-distant-bridge"].contains(&s.name)) { diagnostic(s, Path::new(&root)); }
+        return;
+    }
     let root = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../throwaway/movement");
