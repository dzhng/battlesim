diff --git a/crates/sim/tests/navigation.rs b/crates/sim/tests/navigation.rs
index 8634bbb..4b4d6f9 100644
--- a/crates/sim/tests/navigation.rs
+++ b/crates/sim/tests/navigation.rs
@@ -382,0 +383,30 @@ fn a_nonfinite_cost_keeps_the_original_grid_winner() {
+
+#[test]
+fn a_reused_planner_uses_each_orders_destination_and_mobility() {
+    let w = world(r#","roads":[{"points":[[20,20],[20,160],[380,160],[380,20]],"width_m":10}]"#);
+    let mut reused = grid(&w);
+    for (from, goal, mobility, policy) in [
+        (v2(20.0, 20.0), v2(380.0, 20.0), TANK, RoutePolicy::Fastest),
+        (
+            v2(380.0, 20.0),
+            v2(20.0, 120.0),
+            INFANTRY,
+            RoutePolicy::Fastest,
+        ),
+        (
+            v2(20.0, 120.0),
+            v2(350.0, 40.0),
+            TANK,
+            RoutePolicy::Shortest,
+        ),
+        (v2(350.0, 40.0), v2(60.0, 170.0), TANK, RoutePolicy::Fastest),
+    ] {
+        let expected = route(grid(&w).plan(from, goal, &mobility, policy));
+        let actual = route(reused.plan(from, goal, &mobility, policy));
+        assert_eq!(actual, expected);
+        assert_eq!(
+            reused.route_time(from, &actual, &mobility),
+            grid(&w).route_time(from, &expected, &mobility)
+        );
+    }
+}
