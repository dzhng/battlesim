pub use sim::{math, world};
mod allocation;
#[allow(dead_code)]
mod candidate;
mod instructions;
#[allow(dead_code)]
mod road_graph;
mod scheduler;
mod transit;
use candidate::{Mobility, NavGrid, Refinement, RefinementStatus};
use contract::{
    command::RoutePolicy,
    map::{MapDefinition, MoverClass},
    scenario::{PushClass, Rules},
};
use math::v2;
use world::WorldGeometry;
fn mobility(class: MoverClass) -> Mobility {
    Mobility {
        off_road_mps: 6.0,
        road_mps: 12.0,
        forest_multiplier: 0.4,
        half_width_m: if class == MoverClass::Infantry {
            0.5
        } else {
            1.8
        },
        class,
        push: PushClass::Heavy,
        drive: None,
    }
}
fn scheduler_trace() -> Vec<scheduler::Event> {
    let rules: Rules = serde_json::from_value(sim::fixtures::village()).unwrap();
    let map:MapDefinition=serde_json::from_value(serde_json::json!({"size":[256,256],"fog_cell_m":8,"height_grid_m":4,"slope_cutoff_deg":35})).unwrap();
    let w = WorldGeometry::new(&map, &rules);
    let clear = NavGrid::build(&w, w.props().cloned(), 0.3);
    let mut blocked = serde_json::to_value(&map).unwrap();
    blocked["props"] =
        serde_json::json!([{"kind":"wall","center":[128,128],"yaw":0,"half_extents":[4,20,2]}]);
    let blocked: MapDefinition = serde_json::from_value(blocked).unwrap();
    let w = WorldGeometry::new(&blocked, &rules);
    let blocked = NavGrid::build(&w, w.props().cloned(), 0.3);
    let mut s = scheduler::Scheduler::new();
    let points = vec![v2(20.0, 128.0), v2(240.0, 128.0)];
    let m = mobility(MoverClass::Vehicle);
    s.submit(0, 10, 0, 0, points.clone(), m, RoutePolicy::Fastest);
    s.submit(1, 11, 1, 0, points.clone(), m, RoutePolicy::Fastest);
    assert!(s.advance([&clear, &clear], [0, 0], 64, 8) <= 64);
    assert!(
        s.work_by_unit().iter().all(|(_, work)| *work > 0),
        "round robin must advance both jobs"
    );
    s.submit(0, 20, 0, 0, points.clone(), m, RoutePolicy::Fastest);
    s.cancel(1);
    s.submit(2, 30, 1, 0, points.clone(), m, RoutePolicy::Fastest);
    s.advance([&clear, &clear], [0, 0], 64, 8);
    s.advance([&blocked, &clear], [1, 0], 64, 8);
    s.submit(3, 40, 0, 1, points, m, RoutePolicy::Fastest);
    for _ in 0..10000 {
        if s.pending() == 0 {
            break;
        }
        assert!(s.advance([&blocked, &clear], [1, 0], 256, 64) <= 256);
    }
    assert_eq!(s.pending(), 0);
    assert!(s.events.iter().any(|e| matches!(
        e,
        scheduler::Event::RevisionChanged {
            unit: 0,
            leg: 20,
            ..
        }
    )));
    assert!(s.events.iter().any(|e| matches!(
        e,
        scheduler::Event::PhysicalDecline {
            unit: 3,
            leg: 40,
            ..
        }
    )));
    assert!(s.events.iter().any(|e| matches!(
        e,
        scheduler::Event::Committed {
            unit: 2,
            leg: 30,
            ..
        }
    )));
    s.events
}
fn main() {
    if std::env::args().nth(1).as_deref() == Some("transit") {
        transit::run();
        return;
    }
    let rules: Rules = serde_json::from_value(sim::fixtures::village()).unwrap();
    let map:MapDefinition=serde_json::from_value(serde_json::json!({"size":[256,256],"fog_cell_m":8,"height_grid_m":4,"slope_cutoff_deg":35})).unwrap();
    let world = WorldGeometry::new(&map, &rules);
    let grid = NavGrid::build(&world, world.props().cloned(), 0.3);
    let mut one = Refinement::new(
        v2(20.0, 20.0),
        v2(240.0, 20.0),
        mobility(MoverClass::Vehicle),
        RoutePolicy::Fastest,
    );
    let mut budget = 1;
    assert_eq!(
        one.poll(&grid, &mut budget),
        RefinementStatus::Pending,
        "one credited operation cannot perform whole-segment physical refinement"
    );

    let a = scheduler_trace();
    let b = scheduler_trace();
    assert_eq!(a, b, "same-build scheduler replay");
    println!(
        "{}",
        serde_json::json!({"scheduler_trace":format!("{a:?}"),"same_build_replay":true})
    );
    let rules: Rules = serde_json::from_value(sim::fixtures::village()).unwrap();
    for extra in [
        "",
        r#", "props":[{"kind":"wall","center":[128,128],"yaw":0.4,"half_extents":[4,12,2]}]"#,
        r#", "water":[{"rect":[118,0,20,256],"bed_z":-2,"surface_z":-0.5}],"bridges":[{"deck":"bridge_deck","center":[128,51],"half_extents":[16,5],"yaw":0,"deck_z":0.1,"thickness_m":0.8}]"#,
    ] {
        let raw = format!(
            r#"{{"size":[256,256],"fog_cell_m":8,"height_grid_m":4,"slope_cutoff_deg":35{extra}}}"#
        );
        let map: MapDefinition = serde_json::from_str(&raw).unwrap();
        let w = WorldGeometry::new(&map, &rules);
        for class in [MoverClass::Infantry, MoverClass::Vehicle] {
            for policy in [RoutePolicy::Shortest, RoutePolicy::Fastest] {
                for (a, b) in [
                    (v2(13.0, 90.0), v2(243.0, 166.0)),
                    (v2(13.0, 51.0), v2(243.0, 51.0)),
                    (v2(17.25, 20.125), v2(235.75, 225.375)),
                ] {
                    let grid = NavGrid::build(&w, w.props().cloned(), 0.3);
                    let reference = NavGrid::build(&w, w.props().cloned(), 0.3);
                    let m = mobility(class);
                    let mut job = Refinement::new(a, b, m, policy);
                    let mut small = 1;
                    assert_eq!(
                        job.poll(&grid, &mut small),
                        RefinementStatus::Pending,
                        "a long physical segment cannot finish one unit of work"
                    );
                    assert_eq!(small, 0);
                    let mut polls = 1;
                    let actual = loop {
                        let mut budget = 128;
                        let before = job.work;
                        let status = job.poll(&grid, &mut budget);
                        assert_eq!(job.work - before, 128 - budget);
                        assert!(job.work - before <= 128);
                        polls += 1;
                        match status {
                            RefinementStatus::Pending => {
                                assert!(polls < 100000, "bounded-work refiner must make progress")
                            }
                            RefinementStatus::Complete(value) => break value,
                        }
                    };
                    let expected = reference.reference_segment_cost(a, b, &m, policy);
                    assert_eq!(
                        actual.map(f64::to_bits),
                        expected.map(f64::to_bits),
                        "{class:?} {policy:?} {extra} {a:?}->{b:?}"
                    );
                    println!(
                        "{}",
                        serde_json::json!({"fixture":raw,"class":format!("{class:?}"),"policy":format!("{policy:?}"),"from":[a.x,a.y],"to":[b.x,b.y],"expected_bits":expected.map(f64::to_bits),"actual_bits":actual.map(f64::to_bits),"work":job.work,"polls":polls,"poll_budget":128})
                    );
                }
            }
        }
    }
}
