import {mkdir,writeFile} from 'node:fs/promises';
import {chromium} from '../../web/node_modules/playwright/index.mjs';
import {startServer,WEBGPU_FLAGS,loadRegistry} from '../../web/scene.mjs';
import {cleanupTour} from '../../web/scenes/_battleLook.mjs';
const folder=new URL('./cleanup-buffer-presented-probe/',import.meta.url);
await mkdir(folder,{recursive:true});
const server=await startServer();
const browser=await chromium.launch({channel:'chromium',args:WEBGPU_FLAGS});
const fixture=(await loadRegistry()).find(f=>f.id==='village');
let page;
const history=[]; let failed=false;
const ctx={fixture,url:server.url+fixture.route,check(name,ok,detail){if(!ok) failed=true; console.log(ok?'PASS':'FAIL',name,detail??'');},
 async newPage({viewport}={}){
  const context=await browser.newContext({viewport,deviceScaleFactor:1});page=await context.newPage();
  await page.addInitScript(()=>{
   if(!navigator.gpu)return;
   const live=new Map();
   const requestAdapter=navigator.gpu.requestAdapter.bind(navigator.gpu);
   navigator.gpu.requestAdapter=async(...args)=>{
    const adapter=await requestAdapter(...args);if(!adapter)return adapter;
    const requestDevice=adapter.requestDevice.bind(adapter);
    adapter.requestDevice=async(...deviceArgs)=>{
     const device=await requestDevice(...deviceArgs),create=device.createBuffer.bind(device),destroyDevice=device.destroy.bind(device);
     device.createBuffer=descriptor=>{
      const buffer=create(descriptor);
      live.set(buffer,{device,label:descriptor.label??'',size:buffer.size,usage:buffer.usage,stack:new Error().stack});
      const destroy=buffer.destroy.bind(buffer);buffer.destroy=()=>{live.delete(buffer);destroy();};return buffer;
     };
     device.destroy=()=>{for(const [buffer,record] of live)if(record.device===device)live.delete(buffer);destroyDevice();};return device;
    };return adapter;
   };
   window.__allocationRows=()=>[...live.values()].map(({device,...row})=>row).sort((a,b)=>a.label.localeCompare(b.label)||a.size-b.size);
  });
  const evaluate=page.evaluate.bind(page);
  page.evaluate=async(fn,arg)=>{
   if(String(fn).includes('__lab.setCamera')){
    await page.waitForFunction(()=>{const tick=window.__lab.route.tick(),p=window.__lab.route.presented();return p&&p.tick===tick&&p.clock>=tick-1e-6;},undefined,{timeout:30000,polling:50});
    await evaluate(()=>window.__lab.frame());
    history.push({stage:'before-camera',...await evaluate(()=>({tick:window.__lab.route.tick(),camera:window.__lab.camera(),buffers:window.__allocationRows()}))});
   }
   const result=await evaluate(fn,arg);if(String(fn).includes('__lab.allocations'))history.push({totals:result,...await evaluate(()=>({tick:window.__lab.route?.tick(),buffers:window.__allocationRows?.()}))});return result;};
  page.on('pageerror',e=>console.log('PAGE ERROR',e.message));return page;
 },
 async openLab(p,url=ctx.url){await p.goto(url);await p.waitForFunction(()=>window.__lab?.ready||window.__lab?.error,undefined,{timeout:30000});const e=await p.evaluate(()=>window.__lab.error);if(e)throw Error(e);await p.evaluate(()=>window.__lab.frame());},
 evidencePath:name=>new URL(name,folder).pathname,
 async writeEvidence(name,data){await writeFile(new URL(name,folder),JSON.stringify(data,null,2));await writeFile(new URL('allocation-history.json',folder),JSON.stringify(history,null,2));},
};
try{await cleanupTour(ctx);}finally{await browser.close();await server.close();process.exitCode=failed?1:0;}
