import { readFileSync, writeFileSync, mkdtempSync, rmSync } from "node:fs";
import { createHash } from "node:crypto";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import { pathToFileURL } from "node:url";
import { spawnSync } from "node:child_process";

const [root, binary, destination] = process.argv.slice(2).map((path) => resolve(path));
const wasm = readFileSync(join(root,"web/src/wasm/game_wasm_bg.wasm"));
const { initSync, compile_map } = await import(pathToFileURL(join(root,"web/src/wasm/game_wasm.js")));
initSync({module:wasm});
const request = readFileSync(join(root,"specs/city-maps/assets/map-compiler/rejected-height.json"),"utf8");
const requestJson = JSON.parse(request).request_json;
const descriptor = `[${readFileSync(join(root,"specs/city-maps/assets/template-geometry/asymmetric.json"),"utf8")}]`;
const temporary = mkdtempSync(join(tmpdir(),"mapgen-height-proof-"));
try {
  const requestPath = join(temporary,"request.json");
  const cataloguePath = join(temporary,"catalogue.json");
  writeFileSync(requestPath,requestJson);
  writeFileSync(cataloguePath,descriptor);
  const native = spawnSync(binary,["lower",requestPath,cataloguePath],{encoding:"utf8"});
  const nativeOutcome = native.stdout.replace(/\n$/,"");
  const wasmOutcome = compile_map(requestJson,descriptor);
  if(native.status!==1 || nativeOutcome!==wasmOutcome || JSON.parse(nativeOutcome).status!=="error")
    throw Error("paired height refusal did not reproduce");
  writeFileSync(destination,JSON.stringify({request_json:requestJson,native_outcome:nativeOutcome,
    native_exit_code:native.status,wasm_outcome:wasmOutcome,
    wasm_sha256:createHash("sha256").update(wasm).digest("hex")},null,2)+"\n");
} finally { rmSync(temporary,{recursive:true}); }
